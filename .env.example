# --- Meta WhatsApp Cloud API ---
# From developer.facebook.com -> your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_permanent_system_user_token
PHONE_NUMBER_ID=your_phone_number_id
# A string you invent; must match what you type in the webhook config UI
VERIFY_TOKEN=make_up_a_secret_string
# Optional: verify request signatures (App Dashboard -> Settings -> Basic -> App Secret)
APP_SECRET=your_app_secret

# --- LLM provider: "openrouter" (free models) or "anthropic" (paid, better) ---
LLM_PROVIDER=openrouter

# OpenRouter — get a key at https://openrouter.ai/keys
# Free models end in ":free". Note: free tiers are rate-limited (~50/day)
# and generally log/train on prompts — avoid for sensitive consultant data.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Anthropic — used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Behavior ---
# Comma-separated E.164 numbers that are allowed to auto-receive replies at all.
# Leave blank to respond to everyone who messages you.
ALLOWED_SENDERS=
